# Analysis Backend Configuration
# mediapipe: client-side analysis (default, no server keys required)
# openai: server-side analysis via OpenAI Vision (requires OPENAI_API_KEY)
ANALYSIS_BACKEND=mediapipe

# OpenAI API Configuration (optional; required only if ANALYSIS_BACKEND=openai)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Application Configuration
NODE_ENV=development

# Optional: Google Cloud Vision API (alternative)
# GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-key-here

# Security Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# Logging Configuration
LOG_LEVEL=info
